rules_version = '2';

// Deployed identically to BOTH the raw-videos bucket and the results
// bucket (see firebase.json's two storage targets) — the path prefix
// ("uploads/" vs "results/") is what differs, not the bucket.
//
// `firestore.get(...)` / `firestore.exists(...)` cross-service reads are used
// below to resolve role, attribution, and blocks. The syntax against database
// id "(default)" is proven in production: isClinician() already relies on it,
// which is what lets clinicians review a patient's recording today.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAppUid() {
      return isSignedIn() && request.auth.token.app_uid is string;
    }

    function callerAppUid() {
      return request.auth.token.app_uid;
    }

    // Case-insensitive owner check. The iOS app builds object paths from
    // Swift's UUID.uuidString (UPPERCASE), while the `app_uid` custom claim
    // is a lowercase UUID (Python uuid4 in create_profile). Compare with
    // both sides lowercased so they match regardless of case.
    function isCaller(v) {
      return v.lower() == callerAppUid().lower();
    }

    function isClinician() {
      return hasAppUid()
        && firestore.get(/databases/(default)/documents/profiles/$(callerAppUid())).data.account_type == "clinician";
    }

    // A patient may read the artifacts of a job attributed to them. Object paths
    // are namespaced by whoever RECORDED the video, so a clinician recording for
    // a patient writes under the CLINICIAN's uid. Without this the patient is
    // locked out of their own assessment even though firestore.rules lets them
    // read the job doc. Mirrors isAttributedToCaller in firestore.rules, and the
    // attribution document id IS the jobId.
    function isAttributedToCaller(jobId) {
      return firestore.exists(/databases/(default)/documents/job_patient_attributions/$(jobId))
        && isCaller(firestore.get(/databases/(default)/documents/job_patient_attributions/$(jobId)).data.patient_id);
    }

    // A patient can switch a specific clinician off (patient_blocks in
    // firestore.rules). With no block documents this is always false, so
    // behavior is unchanged.
    function blockedByPatient(pid) {
      return firestore.exists(/databases/(default)/documents/patient_blocks/$(pid.lower() + '__' + callerAppUid().lower()));
    }

    // Raw uploads: uploads/{userId}/{jobId}/video.{ext}
    // Owner read/write (the upload itself); clinicians read-only so they
    // can review a patient's original recording.
    match /uploads/{userId}/{jobId}/{fileName} {
      allow read: if hasAppUid()
        && (isCaller(userId)
            || isAttributedToCaller(jobId)
            || (isClinician() && !blockedByPatient(userId)));
      allow write: if hasAppUid() && isCaller(userId);
    }

    // Processed results: results/{userId}/{jobId}/{annotated.mp4,results.json,peak_frame.png}
    // Written only by google_remote_dynaface_worker.py via a service
    // account (Admin SDK / GCS client — bypasses these rules entirely).
    // Clients only ever read.
    match /results/{userId}/{jobId}/{fileName} {
      allow read: if hasAppUid()
        && (isCaller(userId)
            || isAttributedToCaller(jobId)
            || (isClinician() && !blockedByPatient(userId)));
      allow write: if false;
    }
  }
}
