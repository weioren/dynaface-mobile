rules_version = '2';

// Mirrors the access patterns from the old Supabase RLS migrations
// (see dynaface-mobile/supabase/migrations/), translated to Firestore.
//
// Identity: `request.auth.token.app_uid` is a custom claim set by the
// `create_profile` Cloud Function at signup — NOT the raw Firebase Auth
// UID. See Authentication.swift and gcp-backend/create_profile/main.py
// for why. All ownership checks below use this claim.
//
// `processing_jobs` status transitions (queued -> processing -> completed
// /failed) are written by google_remote_dynaface_worker.py and
// firestore_function.py using the Admin SDK, which bypasses these rules
// entirely — clients only ever read that collection after creating it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAppUid() {
      return isSignedIn() && request.auth.token.app_uid is string;
    }

    function callerAppUid() {
      return request.auth.token.app_uid;
    }

    // Case-insensitive owner check. The iOS app writes id fields from
    // Swift's UUID.uuidString (UPPERCASE), while the `app_uid` custom claim
    // is a lowercase UUID (Python uuid4 in create_profile). Compare with
    // both sides lowercased so they match regardless of case.
    function isCaller(v) {
      return v.lower() == callerAppUid().lower();
    }

    function isClinician() {
      return hasAppUid()
        && get(/databases/$(database)/documents/profiles/$(callerAppUid())).data.account_type == "clinician";
    }

    // A patient may read a job that's attributed to them (a clinician-recorded
    // assessment logged onto the patient's own timeline). The
    // job_patient_attributions doc id == the processing_jobs id, so look it up
    // by jobId directly. Only evaluated for the patient case (owners and
    // clinicians short-circuit before this), so the extra get() is rare.
    function isAttributedToCaller(jobId) {
      return exists(/databases/$(database)/documents/job_patient_attributions/$(jobId))
        && isCaller(get(/databases/$(database)/documents/job_patient_attributions/$(jobId)).data.patient_id);
    }

    // A patient can switch a specific clinician OFF. The block doc id is
    // {patientAppUid}__{clinicianAppUid}, both lowercased, so the check is one
    // exists() built from the caller plus the patient id already on the document
    // being read. With no block docs every clause below is true, i.e. behavior is
    // exactly what it was before this collection existed.
    function blockedByPatient(pid) {
      return exists(/databases/$(database)/documents/patient_blocks/$(pid.lower() + '__' + callerAppUid().lower()));
    }

    // profiles/{app_uid}
    // Created exclusively by the create_profile Cloud Function (Admin
    // SDK, bypasses these rules) so app_uid minting can't be spoofed by
    // a client — `allow create: if false` is intentional.
    match /profiles/{profileId} {
      // Clinician-role profiles are readable by any signed-in user: that is the
      // directory a patient picks from when choosing who to switch off. Names
      // and emails of providers only; patient profiles stay clinician-only.
      allow read: if hasAppUid()
        && (isCaller(profileId)
            || resource.data.account_type == "clinician"
            || (isClinician() && resource.data.account_type == "patient"));
      allow create: if false;
      allow update: if hasAppUid() && isCaller(profileId);
      allow delete: if false;
    }

    // patient_blocks/{patientAppUid}__{clinicianAppUid} — the patient's own
    // visibility switch, one doc per clinician they turned OFF. Only the patient
    // creates or removes one; the targeted clinician may read it so a client can
    // filter if we ever hide blocked patients from the roster.
    match /patient_blocks/{blockId} {
      allow read: if hasAppUid()
        && (isCaller(resource.data.patient_id) || isCaller(resource.data.clinician_id));
      allow create: if hasAppUid()
        && isCaller(request.resource.data.patient_id)
        && request.resource.data.clinician_id is string;
      allow update: if false;
      allow delete: if hasAppUid() && isCaller(resource.data.patient_id);
    }

    // patients/{patientId} — clinician-owned roster rows. Patients never
    // read this collection directly (they don't know they're on a
    // clinician's unregistered roster).
    match /patients/{patientId} {
      allow read: if isClinician();
      allow create: if isClinician() && isCaller(request.resource.data.clinician_id);
      allow update: if isClinician() && isCaller(resource.data.clinician_id);
      allow delete: if false;
    }

    // processing_jobs/{jobId} — created by the client on upload (see
    // VideoUploadService.swift). `status` must start at "queued"; only
    // the worker (Admin SDK) advances it from there.
    match /processing_jobs/{jobId} {
      allow read: if hasAppUid()
        && (isCaller(resource.data.user_id)
            || isAttributedToCaller(jobId)
            || (isClinician() && !blockedByPatient(resource.data.user_id)));
      allow create: if hasAppUid()
        && isCaller(request.resource.data.user_id)
        && request.resource.data.status == "queued";
      allow update: if false;
      // A clinician may delete a job when removing its assessment from the
      // timeline (full delete). The worker still owns all status updates.
      allow delete: if isClinician();
    }

    // job_patient_attributions/{jobId} — doc id == processing_jobs id, so
    // `set()` is naturally an upsert.
    match /job_patient_attributions/{jobId} {
      allow read: if hasAppUid()
        && (isCaller(resource.data.patient_id)
            || (isClinician() && !blockedByPatient(resource.data.patient_id)));
      allow create, update: if hasAppUid()
        && isCaller(request.resource.data.attributed_by)
        && (isClinician() || isCaller(request.resource.data.patient_id));
      allow delete: if isClinician();
    }

    // timeline_events/{eventId}
    match /timeline_events/{eventId} {
      allow read: if hasAppUid()
        && (isCaller(resource.data.patient_id)
            || (isClinician() && !blockedByPatient(resource.data.patient_id)));
      allow create: if hasAppUid()
        && isCaller(request.resource.data.created_by)
        && (isClinician() || isCaller(request.resource.data.patient_id));
      allow update: if isClinician();
      allow delete: if isClinician();
    }
  }
}
